{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-hand.internal/contracts/watchman_authorized_action.schema.json",
  "title": "WatchmanAuthorizedAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "authorization_book_receipt_id",
    "issuer",
    "issuer_key_id",
    "signature_ref",
    "authorization_content_hash",
    "capital_structure_id",
    "benjamin_decision_receipt_id",
    "benjamin_decision_id",
    "benjamin_decision_hash",
    "candidate_economic_path_id",
    "candidate_economic_path_hash",
    "watchman_pre_action_assessment_id",
    "watchman_pre_action_assessment_hash",
    "watchman_capital_envelope_id",
    "watchman_capital_envelope_hash",
    "responsibility_ref",
    "responsibility_version",
    "action_class",
    "economic_root",
    "instrument_intent",
    "economic_path_type",
    "economic_direction",
    "economic_currency",
    "authorized_economic_amount",
    "authorized_minimum",
    "authorized_maximum",
    "maximum_capital_commitment",
    "issued_at",
    "valid_from",
    "expires_at",
    "idempotency_key",
    "permitted_capability_ids",
    "permitted_provider_families",
    "watchman_policy_version"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "authorization_id": {"type": "string", "minLength": 1},
    "authorization_book_receipt_id": {"type": "string", "minLength": 1},
    "issuer": {"const": "Watchman"},
    "issuer_key_id": {"type": "string", "minLength": 1},
    "signature_ref": {"type": "string", "minLength": 1},
    "authorization_content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "capital_structure_id": {"type": "string", "minLength": 1},
    "benjamin_decision_receipt_id": {"type": "string", "minLength": 1},
    "benjamin_decision_id": {"type": "string", "minLength": 1},
    "benjamin_decision_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_economic_path_id": {"type": "string", "minLength": 1},
    "candidate_economic_path_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "watchman_pre_action_assessment_id": {"type": "string", "minLength": 1},
    "watchman_pre_action_assessment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "watchman_capital_envelope_id": {"type": "string", "minLength": 1},
    "watchman_capital_envelope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "responsibility_ref": {"type": "string", "minLength": 1},
    "responsibility_version": {"type": "string", "minLength": 1},
    "action_class": {
      "enum": ["RISK_INCREASING", "RISK_NEUTRAL", "RISK_REDUCING", "EMERGENCY_PROTECTIVE"]
    },
    "economic_root": {"type": "string", "minLength": 1},
    "instrument_intent": {"type": "string", "minLength": 1},
    "economic_path_type": {"type": "string", "minLength": 1},
    "economic_direction": {"enum": ["INCREASE", "DECREASE"]},
    "economic_currency": {"type": "string", "minLength": 1},
    "authorized_economic_amount": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "authorized_minimum": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "authorized_maximum": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "maximum_capital_commitment": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "permitted_capability_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "permitted_provider_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "watchman_policy_version": {"type": "string", "minLength": 1}
  }
}

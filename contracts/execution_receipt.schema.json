{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-hand.local/contracts/execution-receipt/2.0",
  "title": "HandExecutionReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "authorization_book_receipt_id",
    "governance_id",
    "capability",
    "idempotency_key",
    "instrument",
    "side",
    "requested_quantity",
    "status",
    "venue_order_id",
    "executed_quantity",
    "average_price",
    "executed_at",
    "message"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "receipt_id": {"type": "string", "pattern": "^EXE-"},
    "authorization_book_receipt_id": {"type": "string", "minLength": 1},
    "governance_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instrument": {"type": "string", "minLength": 1},
    "side": {"enum": ["BUY", "SELL"]},
    "requested_quantity": {"type": "string", "minLength": 1},
    "status": {"enum": ["ACCEPTED", "FILLED", "PARTIAL", "REJECTED", "CANCELLED", "DRY_RUN"]},
    "venue_order_id": {"type": ["string", "null"]},
    "executed_quantity": {"type": ["string", "null"]},
    "average_price": {"type": ["string", "null"]},
    "executed_at": {"type": "string", "format": "date-time"},
    "message": {"type": ["string", "null"]}
  }
}

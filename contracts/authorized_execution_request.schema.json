{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-hand.local/contracts/watchman-authorized-execution-request/2.0",
  "title": "WatchmanAuthorizedExecutionRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_book_receipt_id",
    "capability",
    "idempotency_key",
    "instrument",
    "side",
    "quantity",
    "decision_id",
    "governance_id",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "authorization_book_receipt_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "instrument": {"type": "string", "minLength": 1},
    "side": {"enum": ["BUY", "SELL"]},
    "quantity": {"type": "string", "pattern": "^(?:0*[1-9]\\d*)(?:\\.\\d+)?$|^0*\\.\\d*[1-9]\\d*$"},
    "decision_id": {"type": "string", "pattern": "^DEC-"},
    "governance_id": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
